#include "keys_da.h"
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>

&mt { flavor = "tap-preferred"; };

&soft_off { hold-time-ms = <1000>; };

/ {
    keymap {
        compatible = "zmk,keymap";

        default_layer {
            // --------------------------------------------------------------------------------------------------------------------------------
            // | ESC   |  1  |  2  |   3   |  4  |  5  |                   ---                |  6    |  7    |  8    |  9   | 0  |    BKSP   |
            // | TAB   |  DA_Q  |  DA_W  |   DA_E   |  DA_R  |  DA_T  |   (   |           ---        |  )    |  DA_Y    |  DA_U    |  DA_I    |  DA_O   | DA_P  |     -     |
            // | CTRL  |  DA_A  |  DA_S  |   DA_D   |  DA_F  |  DA_G  |   [   |           ---        |  ]    |  DA_H    |  DA_J    |  DA_K    |  DA_L   | ;  |     '     |
            // | SHIFT |  DA_Z  |  DA_X  |   DA_C   |  DA_V  |  DA_B  | PG_UP | PG_DOWN | --- | HOME | END   |  DA_N    |  DA_M    |  ,    |  .   | /  | SHFT(RET) |
            // | CRTL  | ALT | GUI | LOWER |    GUI    | LOWER | DA_SPACE   | --- | DEL  | DA_SPACE |     RAISE     | LEFT  | DOWN | UP |   RIGHT   |

            bindings = <
&mt DA_ONE_HALF ESC  &kp DA_N1     &kp DA_N2  &kp N3    &kp N4    &kp N5                                                       &kp N7    &kp N8    &kp N9     &kp N0        &kp DA_PLUS     &kp BSPC
&kp TAB              &kp DA_Q      &kp DA_W   &kp DA_E  &kp DA_R  &kp DA_T  &trans                               &kp N6        &kp DA_Y  &kp DA_U  &kp DA_I   &kp DA_O      &kp DA_P        &mt DA_ACUTE DA_A_RING
&kp DA_LESS_THAN     &kp DA_A      &kp DA_S   &kp DA_D  &kp DA_F  &kp DA_G  &soft_off                            &soft_off     &kp DA_H  &kp DA_J  &kp DA_K   &kp DA_L      &kp DA_AE       &mt DA_APOSTROPHE DA_O_SLASH
&kp LSHFT            &kp DA_Z      &kp DA_X   &kp DA_C  &kp DA_V  &kp DA_B  &kp PG_UP     &kp PG_DN    &kp HOME  &kp END       &kp DA_N  &kp DA_M  &kp COMMA  &kp DOT       &kp DA_MINUS    &mt RSHFT RET
&kp LCTRL            &kp LEFT_GUI  &kp LALT   &mo 3     &mo 3               &kp DA_SPACE  &mo 1        &kp DEL   &kp DA_SPACE            &mo 2     &kp LEFT   &kp UP_ARROW  &kp DOWN_ARROW  &kp RIGHT
            >;
        };

        lower_layer {
            // --------------------------------------------------------------------------------------------------------------------------
            // | ESC   |  1  |  2  |   3   |   4   |  5  |                   ---              |  6  |  7  |   8  |  9   |  0  |  DEL  |
            // | ESC   |  1  |  2  |   3   |   4   |  5  |   (   |           ---        |  )  |  6  |  7  |   8  |  9   |  0  |  DEL  |
            // | CTRL  |  -  |  =  |   [   |   ]   |  \  |   [   |           ---        |  ]  |  *  |  4  |   5  |  6   |  +  |   -   |
            // | SHIFT | ESC | GUI | COPY  | PASTE |     | PG_UP | PG_DOWN | --- | HOME | END |  \  |  1  |   2  |  3   | RET |  RET  |
            // | CRTL  | ALT | GUI | LOWER |     GUI     | LOWER | DA_SPACE   | --- | DEL  |  0  |    RAISE  | LEFT | DOWN | UP  | RIGHT |

            bindings = <
&sys_reset  &trans              &kp DA_AT         &kp LC(F4)           &kp LA(F4)           &trans                                                  &trans  &trans  &kp KP_SLASH  &kp KP_MULTIPLY  &trans           &trans
&trans      &kp DA_UMLAUT       &kp DA_LESS_THAN  &kp DA_GREATER_THAN  &kp LEFT_BRACE       &kp DA_RIGHT_BRACE    &trans                    &trans  &trans  &kp N7  &kp N8        &kp N9           &kp KP_SUBTRACT  &kp DEL
&trans      &kp DA_APOSTROPHE   &kp DA_EQUAL      &kp DA_BACKSLASH     &kp DA_LEFT_BRACKET  &kp DA_RIGHT_BRACKET  &trans                    &trans  &trans  &kp N4  &kp N5        &kp N6           &kp KP_PLUS      &kp KP_MINUS
&trans      &kp LC(LA(DELETE))  &kp PRINTSCREEN   &kp LG(C)            &kp LG(V)            &kp GRAVE             &trans  &trans    &trans  &trans  &trans  &kp N1  &kp N2        &kp N3           &kp RET          &kp RET
&trans      &trans              &trans            &trans               &trans                                     &trans  &trans    &trans  &kp N0          &mo 3   &kp DA_N0     &trans           &trans           &trans
            >;
        };

        raise_layer {
            // ----------------------------------------------------------------------------------------------------------------------------
            // | ESC   |  1  |  2  |   3   |  4  |  5  |                   ---                |  6   |  7   |  8   |  9   |  0    |  DEL  |
            // | ESC   |  !  |  @  |   #   |  $  |  %  |   (   |           ---        |  )    |  ^   |  &   |  *   |  (   |  )    |  DEL  |
            // | CTRL  |  _  |  +  |   {   |  }  | "|" |   [   |           ---        |  ]    | HOME | PGUP | PRSC | UP   |  `    |   ~   |
            // | SHIFT | ESC | GUI |   (   |  )  |     | PG_UP | PG_DOWN | --- | HOME | END   | END  | PGDN | LEFT | DOWN | RIGHT |  RET  |
            // | CRTL  | ALT | GUI | LOWER |    GUI    | LOWER | DA_SPACE   | --- | DEL  | DA_SPACE |    RAISE    | LEFT | DOWN | UP    | RIGHT |

            bindings = <
&trans   &trans             &trans       &trans       &trans             &trans                                          &trans        &trans            &trans        &trans       &trans        &sys_reset
&kp ESC  &kp EXCL           &kp DA_AT    &kp DA_HASH  &kp DA_POUND_SIGN  &kp DA_EURO   &trans                    &trans  &kp DA_CARET  &kp DA_AMPERSAND  &kp DA_ASTRK  &kp DA_LPAR  &kp DA_RPAR   &kp DEL
&trans   &kp DA_UNDERSCORE  &kp DA_PLUS  &kp DA_LBRC  &kp DA_RBRC        &kp DA_PIPE   &trans                    &trans  &kp HOME      &kp PG_UP         &kp PSCRN     &kp UP       &kp DA_ACUTE  &kp TILDE
&trans   &trans             &trans       &kp DA_LPAR  &kp DA_RPAR        &kp DA_TILDE  &trans  &trans    &trans  &trans  &kp END       &kp PG_DN         &kp LEFT      &kp DOWN     &kp RIGHT     &kp RET
&trans   &trans             &trans       &mo 3        &trans                           &mo 3   &trans    &trans  &trans                &trans            &trans        &trans       &trans        &trans
            >;
        };

        adjust_layer {
            // -----------------------------------------------------------------------------------------
            // |  F1   |  F2   |    F3    |    F4     |     F5     | F6 |                   ---                | F7  | F8  |  F9  |  F10 | F11 | F12        |
            // | TAB   |       |          |           |            |    | BOOTL |           ---        |  )    | BT1 | BT2 |  BT3 |  BT4 | BT5 | OUTPUT TGL |
            // | CTRL  | MUTE  |  Vol Dn  |  Vol Up   | Play/Pause |    | RESET |           ---        |  ]    | F1  | F2  |  F3  |  F4  | F5  | F6         |
            // | SHIFT | PSCRN |  PSCRN   |   CAPS    |            |    | PG_UP | PG_DOWN | --- | HOME | END   | F7  | F8  |  F9  |  F10 | F11 | F12        |
            // | CRTL  | ALT   |  GUI     |   LOWER   |      GUI        | LOWER | DA_SPACE   | --- | DEL  | DA_SPACE |   RAISE   | LEFT | DOWN | UP  |   RIGHT    |

            bindings = <
&kp F1          &kp F2        &kp F3        &kp F4        &kp F5            &kp F6                                            &kp F7        &kp F8      &kp F9             &kp F10     &kp F11  &kp F12
&bt BT_NXT      &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 3  &none             &none   &bootloader                    &trans     &bt BT_SEL 0  &trans      &kp C_VOL_UP       &trans      &trans   &out OUT_TOG
&bt BT_PRV      &kp K_MUTE    &kp C_VOL_DN  &kp C_VOL_UP  &kp C_PLAY_PAUSE  &none   &sys_reset                     &soft_off  &bt BT_SEL 1  &kp C_PREV  &kp C_PLAY_PAUSE   &kp C_NEXT  &trans   &trans
&bt BT_CLR_ALL  &kp PSCRN     &kp PSCRN     &kp CLCK      &none             &none   &trans       &trans    &trans  &trans     &bt BT_SEL 2  &kp K_MUTE  &kp C_VOLUME_DOWN  &trans      &trans   &trans
&trans          &trans        &trans        &trans        &trans                    &trans       &trans    &trans  &trans                   &trans      &trans             &trans      &trans   &trans
            >;
        };
    };
};
